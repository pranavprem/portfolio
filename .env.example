# Copy only the nonsecret defaults into a local, Git-ignored .env.
# Optional direct-Python configuration. Docker sets production in compose.yaml.
# Local Compose needs no .env file, connector variables, or token.
PORTFOLIO_ENV=development

# Production only: set to 1 AFTER verifying public HTTPS and the edge redirect.
# Local development always omits HSTS. No includeSubDomains or preload promise.
PORTFOLIO_HSTS=0

# Production uses: compose.yaml + compose.tunnel.yaml (not compose.local.yaml).
# Set this secret directly in Portainer, or in a protected external production env file.
# Compose maps it to cloudflared's supported TUNNEL_TOKEN environment variable.
# CLOUDFLARED_TOKEN=<raw tunnel token>

# Optional image override: use a reviewed release tag AND its verified digest.
# The tunnel override already has a pinned default supporting amd64 and arm64.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.3@sha256:51c9cefcb4569df44e1ad403ab1d3d8065aa8e84339bcfc6aee75502e1140339

# Configure remotely in Cloudflare: pranavprem.com -> http://app:8000
# Origin HTTP Host Header: pranavprem.com. Do not put ingress config or tokens here.
